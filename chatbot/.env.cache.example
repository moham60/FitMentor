# ── Cache Configuration (Optional, uses in-memory by default) ────────────────

# Redis URL for distributed caching (optional, leave empty for in-memory only)
# REDIS_URL=redis://localhost:6379/0

# Cache TTLs (in seconds)
CACHE_USER_CONTEXT_TTL=300         # User profile/inbody cache: 5 minutes
CACHE_QUERY_TTL=120                # Full RAG response cache: 2 minutes
CACHE_EMBEDDING_TTL=3600           # Query embeddings cache: 1 hour
CACHE_VECTOR_SEARCH_TTL=120        # Vector search results cache: 2 minutes

# ── Example of cache hit scenarios ─────────────────────────────────────────────

# Scenario 1: Repeated Query (same user, same question within 2 min)
#   - Result: <100ms response (full response from cache)
#   - Savings: 1.5s → 0.1s (95% faster)

# Scenario 2: Similar Query (same user, similar questions)
#   - Result: ~300ms response (embedding + vector search cached, fresh LLM call)
#   - Savings: 1.5s → 0.3s (80% faster)

# Scenario 3: New Query (first time for user)
#   - Result: ~1.2s response (full pipeline)
#   - Improvement: Parallel Supabase calls + optimized routing
#   - Savings: 3-8s → 1.2s (65-85% faster)
